{
  "name": "duplo-train-slides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Slidev deck: How I hacked my son's LEGO Duplo train \u2014 styled after the Allegro Tech Meeting #19 template",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base ./",
    "export": "slidev export --per-slide --format pdf --output dist/duplo-train.pdf",
    "export:png": "slidev export --per-slide --format png --output dist/png",
    "notes": "slidev export-notes --output dist/speaker-notes.pdf",
    "open": "slidev --open"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.62.1"
  }
}
